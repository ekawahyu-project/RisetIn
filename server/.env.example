# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Cloud (Neon / Supabase Postgres / Railway)
# Contoh Neon:     postgresql://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Contoh Supabase: postgresql://postgres.[ref]:[pass]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Auth JWT (ganti dengan string acak panjang untuk produksi)
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Google Gemini API Key (ambil dari https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
